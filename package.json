{
  "name": "web-vaccine-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Panel histórico de vacunación COVID-19 por país, sobre el dataset completo de Our World in Data (pandemia cerrada, sin API en vivo).",
  "author": "Damian Sire <damiansire@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damiansire/web-vaccine-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/damiansire/web-vaccine-tracker/issues"
  },
  "keywords": [
    "covid",
    "vaccine",
    "tracker",
    "react",
    "dataviz",
    "historical-data"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/web-vaccine-tracker/ && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:data": "node scripts/generate-dataset.ts",
    "verify": "npm run lint && npm run test && npm run build && node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.3.6",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-svg-worldmap": "^2.0.2",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
