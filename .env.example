# Variables de entorno (copiar a .env.development / .env.production).
# Estos archivos están en .gitignore: no se versionan.

# Fuente de datos: "api" usa la API remota; cualquier otro valor (o ausencia)
# sirve el dataset estático modular incluido en src/data (default).
REACT_APP_DATA_SOURCE=

# Endpoint de la API de vacunación. Solo se usa cuando REACT_APP_DATA_SOURCE=api.
REACT_APP_VACCINATION_API_ENDPOINT=https://api.thecovidvaccines.com/api/v1
